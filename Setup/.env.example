# Copy to `.env` in this folder (`Setup/.env`) and adjust before deploying.
# docker compose reads this file automatically when run from the Setup/ folder.

# Secret used to sign JWT auth tokens: a long random string (32+ chars), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left as a placeholder or too short, the backend generates one and stores
# it in the data volume (data/.jwt_secret).
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated origins allowed by the FastAPI CORS middleware. Only matters
# if you point a separately-hosted frontend (e.g. `vite dev`) at the backend;
# in the default compose the frontend proxies /api so CORS isn't exercised.
CORS_ORIGINS=http://localhost:3000

# Host port the frontend is published on (container always listens on 80).
FRONTEND_PORT=3000

# Allow new people to create accounts (true/false).
ALLOW_REGISTRATION=true

# On the first upgrade from the single-user version, existing data is given to
# an account with this username and the old password (6-32 chars: a-z, 0-9, _).
OWNER_USERNAME=pocketman
