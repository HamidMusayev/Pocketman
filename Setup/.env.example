# Copy to `.env` in this folder (`Setup/.env`) and adjust before deploying.
# docker compose reads this file automatically when run from the Setup/ folder.

# Secret used to sign JWT auth tokens. CHANGE THIS to a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated origins allowed by the FastAPI CORS middleware. Only matters
# if you point a separately-hosted frontend (e.g. `vite dev`) at the backend;
# in the default compose the frontend proxies /api so CORS isn't exercised.
CORS_ORIGINS=http://localhost:3000

# Host port the frontend is published on (container always listens on 80).
FRONTEND_PORT=3000
